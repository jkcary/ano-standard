{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:ano:schema:0.5.0:federation-release-bundle",
  "title": "ANO Signed Federation Release Bundle", "type": "object", "additionalProperties": false,
  "required": ["bundle_id", "schema_version", "federation_id", "epoch", "previous_bundle_hash", "policy", "packages", "view_hash", "issuer", "key_id", "issued_at", "bundle_hash", "signature"],
  "properties": {
    "bundle_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "schema_version": {"const": "0.5.0"},
    "federation_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "epoch": {"type": "integer", "minimum": 1},
    "previous_bundle_hash": {"oneOf": [{"$ref": "urn:ano:schema:0.5.0:common#/$defs/hash"}, {"type": "null"}]},
    "policy": {"$ref": "urn:ano:schema:0.5.0:federation-policy"},
    "packages": {"type": "array", "minItems": 1, "items": {"$ref": "urn:ano:schema:0.5.0:capability-package"}},
    "view_hash": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/hash"}, "issuer": {"type": "string", "minLength": 3, "maxLength": 512},
    "key_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "issued_at": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/timestamp"},
    "bundle_hash": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/hash"}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"}
  }
}
