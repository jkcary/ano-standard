{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:ano:schema:0.5.0:learning-withdrawal-event",
  "title": "ANO Signed Federated Learning Withdrawal", "type": "object", "additionalProperties": false,
  "required": ["withdrawal_id", "schema_version", "federation_id", "policy_hash", "source_id", "source_version", "reason", "malicious", "expected_assets", "issuer", "key_id", "issued_at", "event_hash", "signature"],
  "properties": {
    "withdrawal_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "schema_version": {"const": "0.5.0"},
    "federation_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "policy_hash": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/hash"},
    "source_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "source_version": {"type": "integer", "minimum": 1},
    "reason": {"type": "string", "minLength": 3, "maxLength": 1024}, "malicious": {"type": "boolean"},
    "expected_assets": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$"}, "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}}},
    "issuer": {"type": "string", "minLength": 3, "maxLength": 512}, "key_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"},
    "issued_at": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/timestamp"}, "event_hash": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/hash"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"}
  }
}
