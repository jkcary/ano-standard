{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.5.0:distributed-lease",
  "title": "ANO Distributed Worker Lease",
  "type": "object", "additionalProperties": false,
  "required": ["lease_id", "schema_version", "resource_id", "node_id", "epoch", "acquired_at", "heartbeat_at", "expires_at"],
  "properties": {
    "lease_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.5.0"},
    "resource_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"},
    "node_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"},
    "epoch": {"type": "integer", "minimum": 1},
    "acquired_at": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/timestamp"},
    "heartbeat_at": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/timestamp"},
    "expires_at": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/timestamp"}
  }
}
