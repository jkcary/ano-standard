{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:ano:schema:0.5.0:federation-view-checkpoint",
  "title": "ANO Signed Federation Node View Checkpoint", "type": "object", "additionalProperties": false,
  "required": ["checkpoint_id", "schema_version", "federation_id", "node_id", "epoch", "bundle_hash", "view_hash", "key_id", "observed_at", "signature"],
  "properties": {
    "checkpoint_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "schema_version": {"const": "0.5.0"},
    "federation_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "node_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"},
    "epoch": {"type": "integer", "minimum": 1}, "bundle_hash": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/hash"},
    "view_hash": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/hash"}, "key_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"},
    "observed_at": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/timestamp"}, "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"}
  }
}
