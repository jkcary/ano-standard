{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.5.0:artifact-trust-decision",
  "title": "ANO Artifact Supply-chain Trust Decision",
  "type": "object", "additionalProperties": false,
  "required": ["decision_id", "schema_version", "status", "artifact_hash", "attestation_id", "attestation_hash", "sbom_hash", "builder_id", "verified_at"],
  "properties": {
    "decision_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "schema_version": {"const": "0.5.0"}, "status": {"const": "trusted"},
    "artifact_hash": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/hash"}, "attestation_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"},
    "attestation_hash": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/hash"}, "sbom_hash": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/hash"},
    "builder_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "verified_at": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/timestamp"}
  }
}
