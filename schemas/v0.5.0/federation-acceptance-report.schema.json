{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:ano:schema:0.5.0:federation-acceptance-report",
  "title": "ANO 0.5 Federated Growth Acceptance Report", "type": "object", "additionalProperties": false,
  "required": ["report_id", "schema_version", "implementation_version", "implementation_source_hash", "generated_at", "status", "checks", "final_epoch", "consistent_view_hash", "budget_allocation_id", "slo_decision_id", "withdrawal_id", "network_runtime_verified"],
  "properties": {
    "report_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "schema_version": {"const": "0.5.0"},
    "implementation_version": {"type": "string", "minLength": 1}, "implementation_source_hash": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/hash"},
    "generated_at": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/timestamp"}, "status": {"enum": ["passed", "failed"]},
    "checks": {"type": "array", "minItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["check", "status", "detail"], "properties": {"check": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "status": {"enum": ["passed", "failed"]}, "detail": {"type": "string", "minLength": 1}}}},
    "final_epoch": {"type": "integer", "minimum": 2}, "consistent_view_hash": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/hash"},
    "budget_allocation_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "slo_decision_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"},
    "withdrawal_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "network_runtime_verified": {"const": false}
  }
}
