{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.5.0:secret-lease",
  "title": "ANO Short-lived Purpose-bound Secret Lease",
  "type": "object", "additionalProperties": false,
  "required": ["lease_id", "schema_version", "secret_id", "subject", "audience", "purpose", "issued_at", "expires_at", "max_redemptions", "lease_token"],
  "properties": {
    "lease_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "schema_version": {"const": "0.5.0"},
    "secret_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "subject": {"type": "string", "minLength": 3, "maxLength": 512},
    "audience": {"type": "string", "minLength": 3, "maxLength": 256}, "purpose": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"},
    "issued_at": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/timestamp"}, "expires_at": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/timestamp"},
    "max_redemptions": {"type": "integer", "minimum": 1, "maximum": 10}, "lease_token": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"}
  }
}
