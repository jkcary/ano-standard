{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.5.0:secret-security-event",
  "title": "ANO Secret Security Event",
  "type": "object", "additionalProperties": false,
  "required": ["event_id", "schema_version", "lease_id", "event_type", "detected_at", "token_fingerprint", "lease_revoked"],
  "properties": {
    "event_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "schema_version": {"const": "0.5.0"},
    "lease_id": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/identifier"}, "event_type": {"const": "credential_leak"},
    "detected_at": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/timestamp"},
    "token_fingerprint": {"$ref": "urn:ano:schema:0.5.0:common#/$defs/hash"}, "lease_revoked": {"const": true}
  }
}
