{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:deployment-receipt",
  "title": "ANO External Deployment Receipt",
  "type": "object", "additionalProperties": false,
  "required": ["receipt_id", "schema_version", "deployment_id", "provider_id", "artifact_hash", "isolation_execution_hash", "external_ref", "generation", "created_at", "status"],
  "properties": {
    "receipt_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "deployment_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "provider_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "artifact_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"},
    "isolation_execution_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"},
    "external_ref": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
    "status": {"enum": ["staged", "active", "rolled_back", "failed"]}
  }
}
