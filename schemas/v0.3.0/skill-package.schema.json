{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:ano:schema:0.3.0:skill-package", "title": "ANO Skill Package",
  "type": "object", "additionalProperties": false,
  "required": ["skill_id", "schema_version", "version", "inputs_schema_ref", "outputs_schema_ref", "required_tools", "required_permissions", "side_effects", "risk_level", "eval_suite_id", "artifact_hash", "source_ids", "approval_ids", "monitoring_policy_id", "rollback_version", "status"],
  "properties": {
    "skill_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}, "schema_version": {"const": "0.3.0"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "inputs_schema_ref": {"type": "string", "minLength": 1}, "outputs_schema_ref": {"type": "string", "minLength": 1},
    "required_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "required_permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "side_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "risk_level": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/risk_level"}, "eval_suite_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}, "artifact_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}}, "approval_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}},
    "monitoring_policy_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}, "rollback_version": {"type": ["string", "null"]},
    "status": {"enum": ["candidate", "sandbox", "tested", "evaluated", "approved", "staged", "production", "monitored", "revised", "suspended", "rolled_back", "retired", "invalidated"]}
  }
}
