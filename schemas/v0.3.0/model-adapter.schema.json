{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:model-adapter",
  "title": "ANO Model Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_id", "schema_version", "provider", "model_id", "model_revision",
    "interface_version", "modalities", "capabilities", "limits",
    "operational_profile", "safety_profile_id", "eval_report_id", "status"
  ],
  "properties": {
    "adapter_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "provider": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "model_revision": {"type": "string", "minLength": 1},
    "interface_version": {"type": "string", "pattern": "^ano-model-adapter/[0-9]+\\.[0-9]+$"},
    "modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["text", "image", "audio", "video"]}
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/confidence"}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_tokens", "max_output_tokens"],
      "properties": {
        "context_tokens": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "operational_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_p95_ms", "input_cost_per_million_tokens"],
      "properties": {
        "latency_p95_ms": {"type": "integer", "minimum": 0},
        "input_cost_per_million_tokens": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/money"}
      }
    },
    "safety_profile_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "eval_report_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "status": {"enum": ["candidate", "approved", "active", "degraded", "suspended", "retired"]}
  }
}
