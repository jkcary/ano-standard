{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:approval",
  "title": "ANO Informed Approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["approval_id", "schema_version", "version", "action_id", "proposer_id", "parameters_hash", "risk_level", "disclosures", "required_roles", "decisions", "requested_at", "expires_at", "status"],
  "properties": {
    "approval_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "version": {"type": "integer", "minimum": 1},
    "action_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "proposer_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "parameters_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"},
    "risk_level": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/risk_level"},
    "disclosures": {
      "type": "object", "additionalProperties": false,
      "required": ["what", "who", "when", "key_parameters", "data_scope", "reversibility", "residual_effects", "credentials", "downstream_agents", "uncertainties", "alternatives", "inaction_consequence", "validity", "revocation_method", "notifications"],
      "properties": {
        "what": {"type": "string", "minLength": 1}, "who": {"type": "string", "minLength": 1}, "when": {"type": "string", "minLength": 1},
        "key_parameters": {"type": "object"}, "data_scope": {"type": "array", "items": {"type": "string"}},
        "reversibility": {"enum": ["reversible", "compensatable", "irreversible"]},
        "residual_effects": {"type": "array", "items": {"type": "string"}},
        "credentials": {"type": "array", "items": {"type": "string"}},
        "downstream_agents": {"type": "array", "items": {"type": "string"}},
        "uncertainties": {"type": "array", "items": {"type": "string"}},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "inaction_consequence": {"type": "string"}, "validity": {"type": "string", "minLength": 1},
        "revocation_method": {"type": "string", "minLength": 1}, "notifications": {"type": "string", "minLength": 1}
      }
    },
    "required_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["approver_id", "role", "decision", "decided_at"],
        "properties": {
          "approver_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "role": {"type": "string", "minLength": 1}, "decision": {"enum": ["approve", "reject"]},
          "decided_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"}
        }
      }
    },
    "requested_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
    "expires_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
    "status": {"enum": ["requested", "approved", "rejected", "expired", "revoked"]}
  }
}
