{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:traffic-route",
  "title": "ANO External Traffic Route Receipt",
  "type": "object", "additionalProperties": false,
  "required": ["route_id", "schema_version", "deployment_id", "router_id", "previous_fraction", "candidate_fraction", "scope_hash", "generation", "updated_at", "status"],
  "properties": {
    "route_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "deployment_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "router_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "previous_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "candidate_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "scope_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"},
    "generation": {"type": "integer", "minimum": 1},
    "updated_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
    "status": {"enum": ["applied", "rolled_back", "failed"]}
  }
}
