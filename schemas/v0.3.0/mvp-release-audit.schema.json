{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:mvp-release-audit",
  "title": "ANO MVP Release Audit",
  "type": "object", "additionalProperties": false,
  "required": ["audit_id", "schema_version", "implementation_version", "audited_at", "status", "checks", "inventory", "remaining_work"],
  "properties": {
    "audit_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "implementation_version": {"type": "string", "minLength": 1},
    "audited_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
    "status": {"enum": ["passed", "failed"]},
    "checks": {
      "type": "array", "minItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["check", "status", "detail"],
        "properties": {
          "check": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "status": {"enum": ["passed", "failed"]},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["schemas_including_catalog", "catalog_entries", "examples", "state_machines", "tests_run", "required_tests", "passed", "skipped"],
      "properties": {
        "schemas_including_catalog": {"type": "integer", "minimum": 1},
        "catalog_entries": {"type": "integer", "minimum": 1},
        "examples": {"type": "integer", "minimum": 1},
        "state_machines": {"type": "integer", "minimum": 1},
        "tests_run": {"type": "integer", "minimum": 1},
        "required_tests": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 1},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "remaining_work": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item", "classification", "mvp_blocking"],
        "properties": {
          "item": {"type": "string", "minLength": 1},
          "classification": {"enum": ["productionization", "independent_certification", "future_interoperability"]},
          "mvp_blocking": {"const": false}
        }
      }
    }
  }
}
