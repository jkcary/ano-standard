{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:verification",
  "title": "ANO Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_id", "schema_version", "subject_type", "subject_id", "criterion",
    "method", "evidence_ids", "result", "verifier_id", "verified_at"
  ],
  "properties": {
    "verification_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "subject_type": {"enum": ["tool", "action", "task", "goal"]},
    "subject_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "criterion": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}
    },
    "result": {"enum": ["passed", "failed", "inconclusive", "revoked"]},
    "verifier_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "verified_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"}
  }
}

