{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:identity",
  "title": "ANO Identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organism_id", "schema_version", "version", "name", "organism_type",
    "created_at", "status", "principals", "roles", "responsibilities",
    "immutable_constraints", "public_keys"
  ],
  "properties": {
    "organism_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "version": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "organism_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$"},
    "created_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
    "status": {"enum": ["provisioning", "active", "suspended", "terminating", "terminated"]},
    "principals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principal_id", "relationship"],
        "properties": {
          "principal_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "relationship": {"enum": ["owner", "controller", "operator", "beneficiary", "auditor"]}
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$"},
      "uniqueItems": true
    },
    "responsibilities": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
      "uniqueItems": true
    },
    "immutable_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
      "uniqueItems": true
    },
    "public_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "public_key", "status"],
        "properties": {
          "key_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "algorithm": {"type": "string", "minLength": 1},
          "public_key": {"type": "string", "minLength": 1},
          "status": {"enum": ["active", "revoked", "expired"]}
        }
      }
    }
  }
}

