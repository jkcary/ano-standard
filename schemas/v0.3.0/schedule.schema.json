{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:schedule",
  "title": "ANO Persistent Schedule",
  "$defs": {
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "expression"],
      "properties": {
        "type": {"enum": ["absolute_time", "relative_time", "recurring", "event", "state", "condition", "deadline", "dependency", "time"]},
        "expression": {"type": "string", "minLength": 1},
        "termination_condition": {"type": ["string", "null"]},
        "max_fires": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schedule_id", "schema_version", "version", "commitment_id", "trigger", "next_fire_at", "expires_at", "status", "idempotency_key"],
  "properties": {
    "schedule_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "version": {"type": "integer", "minimum": 1},
    "commitment_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "trigger": {"$ref": "#/$defs/trigger"},
    "next_fire_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
    "expires_at": {
      "oneOf": [
        {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
        {"type": "null"}
      ]
    },
    "status": {"enum": ["active", "triggered", "paused", "expired", "cancelled"]},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 256}
  }
}
