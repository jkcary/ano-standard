{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:delegation",
  "title": "ANO Scoped Delegation",
  "type": "object", "additionalProperties": false,
  "required": ["delegation_id", "schema_version", "version", "parent_grant_id", "delegator_id", "delegatee_id", "capabilities", "resource_scope", "data_scope", "expires_at", "status", "downstream_ids"],
  "properties": {
    "delegation_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}, "schema_version": {"const": "0.3.0"}, "version": {"type": "integer", "minimum": 1},
    "parent_grant_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}, "delegator_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}, "delegatee_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "resource_scope": {"type": "object"}, "data_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "expires_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
    "status": {"enum": ["active", "revoked", "blocked", "unknown", "expired"]},
    "downstream_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}}
  }
}
