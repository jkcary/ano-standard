{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:decision-context-snapshot",
  "title": "ANO Decision Context Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id", "schema_version", "run_id", "state_versions", "model_adapter_id",
    "model_revision", "sampling_parameters_hash", "normalized_input_artifact",
    "tool_observation_ids", "policy_versions", "schema_versions", "created_at"
  ],
  "properties": {
    "snapshot_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "run_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "state_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "model_adapter_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "model_revision": {"type": "string", "minLength": 1},
    "sampling_parameters_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"},
    "normalized_input_artifact": {"type": "string", "minLength": 1},
    "tool_observation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}
    },
    "policy_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}
    },
    "schema_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "created_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"}
  }
}

