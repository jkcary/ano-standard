{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:state-machine",
  "title": "ANO State Machine Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["machine_id", "schema_version", "entity_type", "initial_state", "states", "terminal_states", "transitions"],
  "properties": {
    "machine_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "entity_type": {"type": "string", "minLength": 1},
    "initial_state": {"type": "string", "minLength": 1},
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "terminal_states": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "event", "to", "guards"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "event": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
          "to": {"type": "string", "minLength": 1},
          "guards": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}

