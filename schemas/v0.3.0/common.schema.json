{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:common",
  "title": "ANO Common Types",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{2,127}$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "epistemic_status": {
      "enum": ["observed", "asserted", "inferred", "predicted", "disputed"]
    },
    "sensitivity": {
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "risk_level": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id", "parent_ids", "observed_at"],
      "properties": {
        "source_type": {
          "enum": ["conversation", "tool", "sensor", "import", "derived", "system", "agent"]
        },
        "source_id": {"$ref": "#/$defs/identifier"},
        "parent_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/identifier"},
          "uniqueItems": true
        },
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "integrity_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {"type": "number"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
    }
  }
}

