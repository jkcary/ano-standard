{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:goal",
  "title": "ANO Goal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal_id", "schema_version", "owner_id", "title", "goal_type",
    "parent_goal_id", "source_event_ids", "priority", "success_criteria",
    "constraints", "status", "version"
  ],
  "properties": {
    "goal_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "owner_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "goal_type": {"enum": ["user", "organization", "project", "derived", "safety", "maintenance"]},
    "parent_goal_id": {
      "oneOf": [
        {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
        {"type": "null"}
      ]
    },
    "source_event_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
      "uniqueItems": true
    },
    "priority": {"type": "number", "minimum": 0, "maximum": 1},
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "description", "verification_method"],
        "properties": {
          "criterion_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "description": {"type": "string", "minLength": 1},
          "verification_method": {"type": "string", "minLength": 1}
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/money"},
        "deadline": {
          "oneOf": [
            {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
            {"type": "null"}
          ]
        }
      }
    },
    "status": {"enum": ["proposed", "active", "paused", "blocked", "completed", "failed", "cancelled", "superseded"]},
    "version": {"type": "integer", "minimum": 1}
  }
}

