{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:witness-service-state",
  "title": "ANO Durable External Witness State",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "key_id", "runner_domain", "witness_domain", "sequence", "issued_runs", "last_run_id", "last_report_hash", "last_envelope_hash", "last_envelope", "updated_at"],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "key_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "runner_domain": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "witness_domain": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "sequence": {"type": "integer", "minimum": 1},
    "issued_runs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["run_id", "report_hash", "envelope_hash", "envelope"],
        "properties": {
          "run_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "report_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"},
          "envelope_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"},
          "envelope": {"$ref": "urn:ano:schema:0.3.0:cluster-evidence-envelope"}
        }
      }
    },
    "last_run_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "last_report_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"},
    "last_envelope_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"},
    "last_envelope": {"$ref": "urn:ano:schema:0.3.0:cluster-evidence-envelope"},
    "updated_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"}
  }
}
