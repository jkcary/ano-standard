{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:cluster-evidence-statement",
  "title": "ANO Independent Cluster Evidence Statement",
  "type": "object", "additionalProperties": false,
  "required": ["statement_id", "schema_version", "predicate_type", "subject", "runner_domain", "witness_domain", "witnessed_at", "witness_sequence", "previous_envelope_hash", "witness_policy"],
  "properties": {
    "statement_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "predicate_type": {"const": "urn:ano:predicate:cluster-validation:v1"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "report_hash"],
      "properties": {
        "run_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
        "report_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"}
      }
    },
    "runner_domain": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "witness_domain": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "witnessed_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
    "witness_sequence": {"type": "integer", "minimum": 1},
    "previous_envelope_hash": {"oneOf": [{"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"}, {"type": "null"}]},
    "witness_policy": {"const": "independent-domain-v1"},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "source_domain", "source_key_id", "source_envelope_hash", "acquisition_method", "collected_at"],
      "properties": {
        "source_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
        "source_domain": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
        "source_key_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
        "source_envelope_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"},
        "acquisition_method": {"const": "direct-fetch-signed-source-v1"},
        "collected_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"}
      }
    }
  }
}
