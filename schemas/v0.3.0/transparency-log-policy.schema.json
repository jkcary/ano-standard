{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:transparency-log-policy",
  "title": "ANO Transparency Log Trust Policy",
  "type": "object", "additionalProperties": false,
  "required": ["policy_id", "schema_version", "policy_version", "issued_at", "logs"],
  "properties": {
    "policy_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "policy_version": {"type": "integer", "minimum": 1},
    "issued_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
    "logs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["log_id", "registry_id", "operator_domain", "key_id", "algorithm", "public_key_sha256", "status", "valid_from", "valid_until", "revoked_at", "revocation_mode"],
        "properties": {
          "log_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "registry_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "operator_domain": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "key_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "algorithm": {"const": "Ed25519"},
          "public_key_sha256": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"},
          "status": {"enum": ["active", "retired", "revoked"]},
          "valid_from": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
          "valid_until": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
          "revoked_at": {"oneOf": [{"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"}, {"type": "null"}]},
          "revocation_mode": {"enum": ["none", "prospective", "retroactive"]}
        }
      }
    }
  }
}
