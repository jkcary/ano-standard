{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:ano:schema:0.3.0:deletion-request", "title": "ANO Deletion Propagation Request",
  "type": "object", "additionalProperties": false,
  "required": ["request_id", "schema_version", "version", "subject_id", "scope", "targets", "requested_at", "completed_at", "status", "exceptions"],
  "properties": {
    "request_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}, "schema_version": {"const": "0.3.0"}, "version": {"type": "integer", "minimum": 1}, "subject_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}, "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "targets": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["target_id", "target_type", "status"], "properties": {"target_id": {"type": "string", "minLength": 1}, "target_type": {"enum": ["primary", "derived", "cache", "backup", "fork", "downstream"]}, "status": {"enum": ["pending", "deleted", "anonymized", "crypto_erased", "failed", "unknown"]}}}},
    "requested_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"}, "completed_at": {"oneOf": [{"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"}, {"type": "null"}]},
    "status": {"enum": ["pending", "propagating", "completed", "partial", "failed"]}, "exceptions": {"type": "array", "items": {"type": "object"}}
  }
}
