{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:ano:schema:0.3.0:canary-deployment", "title": "ANO Bounded Canary Deployment",
  "type": "object", "additionalProperties": false,
  "required": ["deployment_id", "schema_version", "version", "proposal_id", "baseline_hash", "candidate_hash", "scope", "guardrails", "metrics", "rollback_plan_id", "started_at", "finished_at", "status"],
  "properties": {
    "deployment_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}, "schema_version": {"const": "0.3.0"}, "version": {"type": "integer", "minimum": 1}, "proposal_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}, "baseline_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"}, "candidate_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"}, "approval_evidence_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}, "approval_evidence_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["identity_ids", "traffic_fraction", "permissions", "data_refs", "budget"], "properties": {"identity_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}}, "traffic_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "data_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "budget": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/money"}}},
    "guardrails": {"type": "object", "additionalProperties": false, "required": ["minimum_success_rate", "maximum_safety_incidents", "maximum_cost"], "properties": {"minimum_success_rate": {"type": "number", "minimum": 0, "maximum": 1}, "maximum_safety_incidents": {"type": "integer", "minimum": 0}, "maximum_cost": {"type": "number", "minimum": 0}}},
    "metrics": {"type": "object", "additionalProperties": {"type": "number"}}, "rollback_plan_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "started_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"}, "finished_at": {"oneOf": [{"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"}, {"type": "null"}]},
    "status": {"enum": ["proposed", "approved", "running", "promoted", "paused", "rolled_back", "failed"]}
  }
}
