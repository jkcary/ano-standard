{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:cluster-evidence-quorum-bundle",
  "title": "ANO Cluster Evidence Witness Quorum Bundle",
  "type": "object", "additionalProperties": false,
  "required": ["bundle_id", "schema_version", "report_run_id", "report_hash", "quorum_policy_id", "quorum_policy_version", "created_at", "envelopes"],
  "properties": {
    "bundle_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "report_run_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "report_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"},
    "quorum_policy_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "quorum_policy_version": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
    "envelopes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "urn:ano:schema:0.3.0:cluster-evidence-envelope"}
    },
    "source_attestations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["observer_key_id", "source_envelope"],
        "properties": {
          "observer_key_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "source_envelope": {"$ref": "urn:ano:schema:0.3.0:cluster-report-source-envelope"}
        }
      }
    }
  }
}
