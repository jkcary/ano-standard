{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:telemetry-envelope",
  "title": "ANO Signed Remote Telemetry Envelope",
  "type": "object", "additionalProperties": false,
  "required": ["envelope_id", "schema_version", "deployment_id", "sequence", "source_id", "observed_at", "metrics", "previous_hash", "envelope_hash", "key_id", "signature"],
  "properties": {
    "envelope_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "deployment_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "sequence": {"type": "integer", "minimum": 1},
    "source_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "observed_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
    "metrics": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
    "previous_hash": {"oneOf": [{"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"}, {"type": "null"}]},
    "envelope_hash": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/hash"},
    "key_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "signature": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9+/]{86}==$"}
  }
}
