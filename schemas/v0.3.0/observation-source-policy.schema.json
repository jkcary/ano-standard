{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.3.0:observation-source-policy",
  "title": "ANO Observation Source Trust Policy",
  "type": "object", "additionalProperties": false,
  "required": ["policy_id", "schema_version", "policy_version", "issued_at", "maximum_source_age_seconds", "sources"],
  "properties": {
    "policy_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.3.0"},
    "policy_version": {"type": "integer", "minimum": 1},
    "issued_at": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
    "maximum_source_age_seconds": {"type": "integer", "minimum": 0},
    "sources": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "source_domain", "operator_domain", "infrastructure_domain", "upstream_ids", "key_id", "algorithm", "public_key_sha256", "status", "valid_from", "valid_until", "revoked_at", "revocation_mode"],
        "properties": {
          "source_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "source_domain": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "operator_domain": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "infrastructure_domain": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "upstream_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"}
          },
          "key_id": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/identifier"},
          "algorithm": {"const": "Ed25519"},
          "public_key_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "status": {"enum": ["active", "retired", "revoked"]},
          "valid_from": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
          "valid_until": {"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"},
          "revoked_at": {"oneOf": [{"$ref": "urn:ano:schema:0.3.0:common#/$defs/timestamp"}, {"type": "null"}]},
          "revocation_mode": {"enum": ["none", "prospective", "retroactive"]}
        },
        "allOf": [{
          "if": {"properties": {"status": {"const": "revoked"}}, "required": ["status"]},
          "then": {"properties": {"revoked_at": {"type": "string", "format": "date-time"}, "revocation_mode": {"enum": ["prospective", "retroactive"]}}},
          "else": {"properties": {"revoked_at": {"type": "null"}, "revocation_mode": {"const": "none"}}}
        }]
      }
    }
  }
}
