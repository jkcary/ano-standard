{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.4.0:sqlite-backup-manifest",
  "title": "ANO SQLite Backup Manifest",
  "type": "object", "additionalProperties": false,
  "required": ["backup_id", "schema_version", "engine", "created_at", "database_hash", "size_bytes", "integrity_check"],
  "properties": {
    "backup_id": {"$ref": "urn:ano:schema:0.4.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.4.0"},
    "engine": {"const": "sqlite"},
    "created_at": {"$ref": "urn:ano:schema:0.4.0:common#/$defs/timestamp"},
    "database_hash": {"$ref": "urn:ano:schema:0.4.0:common#/$defs/hash"},
    "size_bytes": {"type": "integer", "minimum": 1},
    "integrity_check": {"const": "ok"}
  }
}
