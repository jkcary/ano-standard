{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.4.0:tenant-transfer-envelope",
  "title": "ANO Encrypted Tenant Transfer Envelope",
  "type": "object", "additionalProperties": false,
  "required": ["transfer_id", "schema_version", "tenant_id", "created_at", "algorithm", "nonce", "ciphertext", "package_hash"],
  "properties": {
    "transfer_id": {"$ref": "urn:ano:schema:0.4.0:common#/$defs/identifier"},
    "schema_version": {"const": "0.4.0"},
    "tenant_id": {"$ref": "urn:ano:schema:0.4.0:common#/$defs/identifier"},
    "created_at": {"$ref": "urn:ano:schema:0.4.0:common#/$defs/timestamp"},
    "algorithm": {"const": "AES-256-GCM"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
    "ciphertext": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
    "package_hash": {"$ref": "urn:ano:schema:0.4.0:common#/$defs/hash"}
  }
}
