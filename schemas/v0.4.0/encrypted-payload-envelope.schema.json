{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ano:schema:0.4.0:encrypted-payload-envelope",
  "title": "ANO Tenant Encrypted Payload Envelope",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "key_version", "algorithm", "nonce", "ciphertext", "plaintext_hash", "aad_hash", "encrypted_at"],
  "properties": {
    "schema_version": {"const": "0.4.0"},
    "tenant_id": {"$ref": "urn:ano:schema:0.4.0:common#/$defs/identifier"},
    "key_version": {"type": "integer", "minimum": 1},
    "algorithm": {"const": "AES-256-GCM"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
    "ciphertext": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
    "plaintext_hash": {"$ref": "urn:ano:schema:0.4.0:common#/$defs/hash"},
    "aad_hash": {"$ref": "urn:ano:schema:0.4.0:common#/$defs/hash"},
    "encrypted_at": {"$ref": "urn:ano:schema:0.4.0:common#/$defs/timestamp"}
  }
}
