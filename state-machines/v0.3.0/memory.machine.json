{
  "machine_id": "ano.memory.lifecycle",
  "schema_version": "0.3.0",
  "entity_type": "memory",
  "initial_state": "candidate",
  "states": ["candidate", "active", "superseded", "disputed", "expired", "archived", "deleted"],
  "terminal_states": ["deleted"],
  "transitions": [
    {"from": "candidate", "event": "memory.activated", "to": "active", "guards": ["consent_checked", "sensitivity_checked", "source_present"]},
    {"from": "candidate", "event": "memory.deleted", "to": "deleted", "guards": []},
    {"from": "active", "event": "memory.superseded", "to": "superseded", "guards": ["replacement_linked"]},
    {"from": "active", "event": "memory.disputed", "to": "disputed", "guards": ["conflict_evidence_present"]},
    {"from": "active", "event": "memory.expired", "to": "expired", "guards": []},
    {"from": "active", "event": "memory.archived", "to": "archived", "guards": []},
    {"from": "active", "event": "memory.deleted", "to": "deleted", "guards": []},
    {"from": "disputed", "event": "memory.activated", "to": "active", "guards": ["resolution_recorded"]},
    {"from": "disputed", "event": "memory.superseded", "to": "superseded", "guards": ["replacement_linked", "resolution_recorded"]},
    {"from": "disputed", "event": "memory.deleted", "to": "deleted", "guards": []},
    {"from": "archived", "event": "memory.activated", "to": "active", "guards": ["review_completed"]},
    {"from": "archived", "event": "memory.deleted", "to": "deleted", "guards": []},
    {"from": "expired", "event": "memory.deleted", "to": "deleted", "guards": []},
    {"from": "superseded", "event": "memory.deleted", "to": "deleted", "guards": []}
  ]
}
